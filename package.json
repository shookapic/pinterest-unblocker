{
  "name": "pinterest-unblocker",
  "version": "1.0.1",
  "private": true,
  "description": "Restore unobstructed browsing and native image saving on Pinterest.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "build": "node scripts/build.js",
    "lint:firefox": "npm exec --yes --ignore-scripts --package=web-ext@10.7.0 -- web-ext lint --source-dir dist/firefox --warnings-as-errors",
    "install:browser": "node node_modules/playwright/cli.js install chromium",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "fflate": "0.8.3",
    "jsdom": "26.1.0"
  }
}
